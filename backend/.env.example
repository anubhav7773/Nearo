# ==============================================================================
# Nearo Production Backend Unified Environment Configuration
# Ready for direct copy-paste into Render.com's "Environment Variables" bulk editor
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application & Render Web Service
# ------------------------------------------------------------------------------
PROJECT_NAME="Nearo API"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
SUBDOMAIN="nearo.asiverticals.me"

# Security & Cryptographic Tokens (64-char high entropy string)
SECRET_KEY="generate-a-secure-random-64-character-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL 16 + PostGIS Spatial Database (Mumbai AWS Pooler)
# ------------------------------------------------------------------------------
# Session / Transaction Pooler connection string:
# Format: postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql+asyncpg://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Supabase API & Storage Gateway
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Optional direct parameters (used if DATABASE_URL is not provided)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="nearo_user"
POSTGRES_PASSWORD="nearo_password"
POSTGRES_DB="nearo_db"

# ------------------------------------------------------------------------------
# 3. Firebase Production Authentication & FCM Cloud Messaging
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="nearo-org"
# Service account JSON string (copy-paste compact single-line JSON or pass as Render Secret)
FIREBASE_SERVICE_ACCOUNT=""

# ------------------------------------------------------------------------------
# 4. Upstash / Redis Cache & Real-Time Fallback Broker
# ------------------------------------------------------------------------------
# Upstash Redis URI format: rediss://default:[password]@[endpoint].upstash.io:6379
REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# 5. Google Play In-App Billing & Subscriptions
# ------------------------------------------------------------------------------
GOOGLE_PLAY_PACKAGE_NAME="me.asiverticals.nearo"
# Service account JSON string (or Base64 encoded JSON) for Google Play Developer API
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""

# ------------------------------------------------------------------------------
# 6. AdMob Hyperlocal Ad Units (Live / Test IDs)
# ------------------------------------------------------------------------------
ADMOB_APP_ID="ca-app-pub-3940256099942544~3347511713"
ADMOB_BANNER_AD_UNIT_ID="ca-app-pub-3940256099942544/6300978111"
ADMOB_NATIVE_AD_UNIT_ID="ca-app-pub-3940256099942544/2247696110"

# ------------------------------------------------------------------------------
# 7. Hyperlocal Geospatial & Privacy Jitter Constraints
# ------------------------------------------------------------------------------
DEFAULT_RADIUS_METERS=1500
MAX_RADIUS_METERS=5000
COORDINATE_JITTER_MIN_METERS=100
COORDINATE_JITTER_MAX_METERS=250

# ------------------------------------------------------------------------------
# 8. CORS Allowed Origins (Comma-separated string)
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000,https://nearo.asiverticals.me,https://*.asiverticals.me"
